# Environment Variables for Docker Compose
# Copy this file to .env and update with your actual values
# NEVER commit .env to git!

# Hosted SQL Server (DatabaseASP.net)
DB_CONNECTION_STRING="Server=db39150.public.databaseasp.net;Database=db39150;User Id=db39150;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
MESSAGING_DB_CONNECTION_STRING="Server=db53735.public.databaseasp.net;Database=db53735;User Id=db53735;Password=YOUR_PASSWORD;Encrypt=False;MultipleActiveResultSets=True;"

# Host ports (change if another stack already uses defaults)
MESSAGING_API_PORT=5002
BACKEND_API_PORT=8081
BACKEND_API_HTTPS_PORT=8444
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MGMT_PORT=15673

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# JWT Settings
JWT_SECRET=TrainProjectSecretKey123456789TrainProjectSecretKey123456789

# Email Settings (Gmail Example)
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# For production, generate a secure JWT secret:
# openssl rand -base64 64
# JWT_SECRET=your-generated-secret-here

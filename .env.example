# Environment Variables for Docker Compose
# Copy to .env and update values — mirror Sudan_Train/appsettings.json + MessagingApi/appsettings.json
# NEVER commit .env to git!

# ConnectionStrings
DB_CONNECTION_STRING="Server=...;Database=...;User Id=...;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
MESSAGING_DB_CONNECTION_STRING="Server=...;Database=...;User Id=...;Password=YOUR_PASSWORD;Encrypt=False;MultipleActiveResultSets=True;"

# Host ports
BACKEND_API_PORT=8081
BACKEND_API_HTTPS_PORT=8444
MESSAGING_API_PORT=5002
CUSTOMER_PORT=3000
ADMIN_PORT=3001
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MGMT_PORT=15673

ASPNETCORE_ENVIRONMENT=Development

# jwtSettings
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=TrainProject
JWT_AUDIENCE=TrainProjectUsers

# EmailSettings (Hostinger)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_FROM_NAME=Sudan Train Booking System
EMAIL_FROM=noreply@yourdomain.com
EMAIL_USERNAME=noreply@yourdomain.com
EMAIL_PASSWORD=your-hostinger-mailbox-password
EMAIL_ENABLE_SSL=true
EMAIL_DEFAULT_STRATEGY=Queued

# RabbitMQSettings (local dev; Docker Compose overrides hostname to rabbitmq)
RABBITMQ_HOSTNAME=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# MessagingApi / Frontend
MESSAGING_API_BASE_URL=http://localhost:5002
FRONTEND_BASE_URL=http://localhost:3000

# Google
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: Twilio / Firebase (MessagingApi appsettings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIREBASE_KEY_PATH=
FIREBASE_PROJECT_ID=

# Frontend Vite
VITE_API_URL=http://localhost:8081
VITE_MESSAGING_API_URL=http://localhost:5002
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

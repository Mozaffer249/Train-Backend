								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"sessionId\": {{session_id}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/Sessions/Terminate",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "Sessions", "Terminate"]
						},
						"description": "Terminate a specific session by ID. User will be logged out from that device."
					},
					"response": []
				},
				{
					"name": "Terminate All Sessions (Except Current)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [

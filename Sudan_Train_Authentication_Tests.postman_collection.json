{
	"info": {
		"_postman_id": "auth-modules-test-001",
		"name": "Sudan Train - Authentication Modules Test Suite",
		"description": "Complete test collection for all authentication modules including core security, 2FA, session management, account management, and security notifications",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Registration & Email Confirmation",
			"item": [
				{
					"name": "Register New User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 201\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"pm.test(\"Response has success message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.succeeded).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"testuser1\",\n  \"email\": \"test1@example.com\",\n  \"password\": \"Test@123456\",\n  \"confirmPassword\": \"Test@123456\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phoneNumber\": \"+249123456789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/Register",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "Register"]
						},
						"description": "Register a new user account. Email confirmation required before login."
					},
					"response": []
				},
				{
					"name": "Confirm Email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"code\": \"CONFIRMATION_CODE_FROM_EMAIL\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/ConfirmEmail",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "ConfirmEmail"]
						},
						"description": "Confirm user email with code received via email"
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Login & Logout",
			"item": [
				{
					"name": "Login (Without 2FA)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has access token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.accessToken).to.exist;",
									"    pm.environment.set(\"auth_token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"});",
									"",
									"pm.test(\"Token is valid JWT\", function () {",
									"    var token = pm.response.json().data.accessToken;",
									"    pm.expect(token.split('.')).to.have.lengthOf(3);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"testuser1\",\n  \"password\": \"Test@123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/Login",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "Login"]
						},
						"description": "Login with username and password. Returns JWT tokens."
					},
					"response": []
				},
				{
					"name": "Validate Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/Authentication/ValidateToken?accessToken={{auth_token}}",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "ValidateToken"],
							"query": [
								{
									"key": "accessToken",
									"value": "{{auth_token}}"
								}
							]
						},
						"description": "Validate if JWT token is still valid"
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"auth_token\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"accessToken\": \"{{auth_token}}\",\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/RefreshToken",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "RefreshToken"]
						},
						"description": "Refresh access token using refresh token"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"accessToken\": \"{{auth_token}}\",\n  \"refreshToken\": \"{{refresh_token}}\",\n  \"allDevices\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/Logout",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "Logout"]
						},
						"description": "Logout and revoke tokens. Set allDevices=true to logout from all devices."
					},
					"response": []
				}
			]
		},

								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"exceptCurrent\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/Authentication/Sessions/TerminateAll",
							"host": ["{{baseUrl}}"],
							"path": ["Authentication", "Sessions", "TerminateAll"]
						},
						"description": "Terminate all sessions except current. Set exceptCurrent=false to logout from all devices."
					},
					"response": []
				}
			]
